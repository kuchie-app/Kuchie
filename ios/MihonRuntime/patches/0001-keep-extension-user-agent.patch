diff --git a/server/src/test/kotlin/eu/kanade/tachiyomi/network/interceptor/UserAgentInterceptorTest.kt b/server/src/test/kotlin/eu/kanade/tachiyomi/network/interceptor/UserAgentInterceptorTest.kt
