index 0000000..154cc05
--- /dev/null
+++ b/server/src/test/kotlin/eu/kanade/tachiyomi/network/interceptor/UserAgentInterceptorTest.kt
@@ -0,0 +1,58 @@
+package eu.kanade.tachiyomi.network.interceptor
+
+import okhttp3.Interceptor
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import okhttp3.Request
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class UserAgentInterceptorTest {
+    private fun sentUserAgent(
+        interceptor: UserAgentInterceptor,
+        own: String?,
+    ): String? {
+        var seen: String? = null
+        val capture =
+            Interceptor { chain ->
+                seen = chain.request().header("User-Agent")
+                Response
+                    .Builder()
+                    .request(chain.request())
+                    .protocol(Protocol.HTTP_1_1)
+                    .code(200)
+                    .message("OK")
+                    .body("".toResponseBody())
+                    .build()
+            }
+        val client =
+            OkHttpClient
+                .Builder()
+                .addInterceptor(interceptor)
+                .addInterceptor(capture)
+                .build()
+        val request =
+            Request
+                .Builder()
+                .url("https://api.example.org/")
+                .apply { own?.let { header("User-Agent", it) } }
+                .build()
+        client.newCall(request).execute().close()
+        return seen
+    }
+
+    @Test
+    fun `keeps the user-agent an extension sets, as Mihon does`() {
+        val interceptor = UserAgentInterceptor({ _ -> "default-ua" })
+        assertEquals("Tachiyomi custom", sentUserAgent(interceptor, "Tachiyomi custom"))
+        assertEquals("default-ua", sentUserAgent(interceptor, null))
+    }
+
+    @Test
+    fun `a solved Cloudflare host uses the user-agent that solved it`() {
+        val interceptor = UserAgentInterceptor({ _ -> "default-ua" }, { "solver-ua" })
+        assertEquals("solver-ua", sentUserAgent(interceptor, "Tachiyomi custom"))
+    }
+}
