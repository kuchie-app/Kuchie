--- /dev/null
+++ b/AndroidCompat/src/test/kotlin/android/graphics/BitmapFactoryWebPTest.kt
@@ -0,0 +1,20 @@
+package android.graphics
+
+import java.util.Base64
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class BitmapFactoryWebPTest {
+    // A 1x1 lossless WebP. Extensions that descramble pages decode WebP through
+    // BitmapFactory; it must work even where the native WebP reader cannot load.
+    private val webp = Base64.getDecoder().decode("UklGRhoAAABXRUJQVlA4TA0AAAAvAAAAEAcQERGIiP4HAA==")
+
+    @Test
+    fun `decodes WebP without the native reader`() {
+        val bitmap = BitmapFactory.decodeByteArray(webp, 0, webp.size)
+        assertEquals(1, bitmap.width)
+        assertEquals(1, bitmap.height)
+        val streamed = BitmapFactory.decodeStream(webp.inputStream())
+        assertEquals(1, streamed.width)
+    }
+}
diff --git a/AndroidCompat/src/test/kotlin/android/graphics/BitmapPixelsTest.kt b/AndroidCompat/src/test/kotlin/android/graphics/BitmapPixelsTest.kt
