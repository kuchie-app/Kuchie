--- /dev/null
+++ b/AndroidCompat/src/test/kotlin/android/graphics/BitmapPixelsTest.kt
@@ -0,0 +1,25 @@
+package android.graphics
+
+import kotlin.test.Test
+import kotlin.test.assertContentEquals
+import kotlin.test.assertEquals
+
+class BitmapPixelsTest {
+    @Test
+    fun `copies a tile with getPixels and setPixels, as descramblers do`() {
+        val source = Bitmap.createBitmap(4, 2, Bitmap.Config.ARGB_8888)
+        source.setPixel(1, 0, 0xFF112233.toInt())
+        source.setPixel(2, 1, 0xFF445566.toInt())
+
+        val tile = IntArray(2 * 2)
+        source.getPixels(tile, 0, 2, 1, 0, 2, 2)
+        val target = Bitmap.createBitmap(2, 2, Bitmap.Config.ARGB_8888)
+        target.setPixels(tile, 0, 2, 0, 0, 2, 2)
+
+        assertEquals(0xFF112233.toInt(), target.getPixel(0, 0))
+        assertEquals(0xFF445566.toInt(), target.getPixel(1, 1))
+        val back = IntArray(4)
+        target.getPixels(back, 0, 2, 0, 0, 2, 2)
+        assertContentEquals(tile, back)
+    }
+}
